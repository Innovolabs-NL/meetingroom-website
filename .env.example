# ─── Paddle (checkout on pricing) ─────────────────────────────────────────────
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_PRICE_PERSONAL=
NEXT_PUBLIC_PADDLE_PRICE_TEAM=

# ─── Supabase (Auth + DB for website; same project as desktop app if shared) ─
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: mints a separate session for desktop handoff (website stays signed in)
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL for invite links (no trailing slash). Dev: http://localhost:3000
# Production (Vercel): https://meetingroom-website.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Team invite emails (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Set to true for port 465 (implicit TLS)
SMTP_SECURE=false
EMAIL_FROM=MeetingRoom <noreply@example.com>

# ─── GitHub Releases API (changelog page live feed) ───────────────────────────
# Optional: override default Innovolabs-NL/meetingroom-releases
# GITHUB_RELEASES_REPO=Innovolabs-NL/meetingroom-releases
# Raises rate limits in CI/build (recommended). Not required for public repos.
# GITHUB_RELEASES_TOKEN=
# or: GITHUB_TOKEN=
